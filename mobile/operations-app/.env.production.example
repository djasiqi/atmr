# Gabarit production mobile (EAS / build local). Ne pas committer .env avec secrets.
# Les builds EAS utilisent souvent `eas secret` — ce fichier documente les clés attendues.
# Référence détaillée : env.example (racine operations-app).

APP_VARIANT=prod
EXPO_PUBLIC_APP_ENV=production

EXPO_PUBLIC_API_URL=https://api.lirie.ch
EXPO_PUBLIC_BACKEND_PORT=5000
EXPO_PUBLIC_SOCKET_URL=https://api.lirie.ch

# Clés Maps — à fournir via EAS secrets ou .env local (non versionné)
# EXPO_PUBLIC_GOOGLE_API_KEY=
# EXPO_PUBLIC_ANDROID_MAPS_API_KEY=

# Télémétrie interne — en prod release, désactiver l’ingest dev si besoin
EXPO_PUBLIC_DISABLE_INGEST=true

# Perf LIRIE (optionnel — défauts dans le code si absent)
# EXPO_PUBLIC_LOCATION_SOCKET_STALE_MS=75000
# EXPO_PUBLIC_GPS_FAST_MS=5000
# EXPO_PUBLIC_GPS_SLOW_MS=60000
# EXPO_PUBLIC_LOCATION_PRESENCE_HEARTBEAT_ENABLED=true
# EXPO_PUBLIC_MAP_SILENCE_RESYNC_MS=
# EXPO_PUBLIC_DRIVERS_LIVE_API=

# Sentry (optionnel)
# EXPO_PUBLIC_SENTRY_DSN=
