# Variante de l'application (dev ou prod)
APP_VARIANT=prod

# Configuration API
EXPO_PUBLIC_API_URL=https://api.lirie.ch
EXPO_PUBLIC_BACKEND_PORT=5000

# Configuration Socket.IO
# Production: REQUIS - URL HTTPS
EXPO_PUBLIC_SOCKET_URL=https://api.lirie.ch
# Development: Optionnel - fallback automatique
# Android emulator: http://10.0.2.2:5000
# iOS simulator / Web: http://localhost:5000

# ⚠️ IMPORTANT: Remplacez ces clés par vos vraies clés API
# Ne committez JAMAIS le fichier .env avec les vraies clés
EXPO_PUBLIC_GOOGLE_API_KEY=changeme-google-rest-api-key
EXPO_PUBLIC_ANDROID_MAPS_API_KEY=changeme-android-maps-api-key

# Fichiers de configuration Google Services (optionnel)
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist

# Numéros de build (optionnel, auto-incrémentés en production)
# ANDROID_VERSION_CODE=1
# IOS_BUILD_NUMBER=1

# Forensic auth : logs "refresh_token timeline" (jamais écrit / effacé / illisible)
# Activer uniquement pour debug ; n'expose pas les tokens.
# EXPO_PUBLIC_DEBUG_AUTH=1

