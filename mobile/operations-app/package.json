{
  "name": "liri-operations",
  "main": "index.js",
  "version": "1.0.4",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=8192 node scripts/start-tunnel.js",
    "start:clear": "cross-env NODE_OPTIONS=--max-old-space-size=8192 node scripts/start-tunnel.js --clear",
    "start:dev-local": "cross-env APP_VARIANT=dev EXPO_PUBLIC_USE_PROD_IN_DEV=0 NODE_OPTIONS=--max-old-space-size=8192 node scripts/start-tunnel.js",
    "start:dev-prod": "cross-env APP_VARIANT=dev EXPO_PUBLIC_USE_PROD_IN_DEV=1 NODE_OPTIONS=--max-old-space-size=8192 node scripts/start-tunnel.js",
    "start:tunnel": "node scripts/start-tunnel.js",
    "start:localhost": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --host localhost --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "prebuild": "expo prebuild --clean",
    "eas-build-pre-install": "node ./scripts/write-google-services.js && node ./scripts/eas-preinstall-check.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "cross-env NODE_OPTIONS=--max-old-space-size=12288 expo start --web",
    "env:generate": "node ./scripts/generate-env.js",
    "build:dev": "eas build -p android --profile development",
    "build:prod": "eas build -p android --profile production",
    "build:prod:ios": "eas build -p ios --profile production",
    "build:prod:all": "eas build -p all --profile production",
    "check:build": "node ./scripts/check-build-ready.js",
    "setup:google-services": "node ./scripts/create-google-services-placeholder.js",
    "version:patch": "node ./scripts/bump-version.js && git add app.config.js package.json",
    "test": "jest --watchAll=false",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.3.1",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/messaging": "^23.8.6",
    "@react-native/debugger-frontend": "^0.80.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@sentry/react-native": "~7.2.0",
    "@types/react": "~19.1.10",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "debug": "^4.4.3",
    "dotenv-flow": "^3.3.0",
    "expo": "~54.0.33",
    "expo-application": "~7.0.8",
    "expo-background-fetch": "~14.0.9",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-intent-launcher": "~13.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "^17.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.16",
    "expo-version": "^1.0.2",
    "expo-web-browser": "~15.0.10",
    "formik": "^2.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-maps-directions": "^1.9.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "sentry-expo": "~7.0.0",
    "socket.io-client": "^4.8.1",
    "typescript": "~5.9.2",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.0.2",
    "@types/jest": "29.5.14",
    "@types/node": "^24.3.3",
    "@types/react": "~19.1.10",
    "@types/react-native-maps": "^0.24.1",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.3.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "baseline-browser-mapping": "^2.10.0",
    "cross-env": "^7.0.3",
    "dnssd-advertise": "^1.1.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "fetch-nodeshim": "^0.4.9",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "multitars": "^0.2.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "react-test-renderer": "^19.1.0",
    "toqr": "^0.1.1",
    "typescript": "~5.9.2",
    "zod": "^3.23.0"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.3",
    "react-server-dom-webpack": "19.1.5",
    "qs": "6.14.2",
    "form-data": "^4.0.1",
    "js-yaml": "^4.1.0",
    "tar": ">=7.5.10",
    "@react-native-community/cli-server-api": "^20.0.2",
    "@sentry/browser": "^8.47.0",
    "@sentry/react-native": "~7.2.0",
    "axios": "^1.7.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "glob": "^11.1.0",
    "node-forge": ">=1.3.2",
    "minimatch": "10.2.3",
    "simple-git": "3.32.3",
    "@tootallnate/once": "3.0.1"
  },
  "private": true,
  "type": "commonjs",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-maps-directions"
        ],
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": []
    }
  }
}
