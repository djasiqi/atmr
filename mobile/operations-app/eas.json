{
  "cli": { "version": ">=16.4.8", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "env": {
        "APP_VARIANT": "dev",
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_NO_UPDATES": "1",
        "EXPO_PUBLIC_USE_PROD_IN_DEV": "0"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": false
      },
      "ios": {
        "simulator": false,
        "withoutCredentials": false
      }
    },
    "internal": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "prod",
        "EXPO_PUBLIC_APP_ENV": "preview"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "env": {
        "APP_VARIANT": "prod",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_USE_COMMUNITY_AUTOLINKING": "1"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true,
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "simulator": false,
        "autoIncrement": true,
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "production"
      },
      "ios": {
        "appleId": "jasiqi.drin@gmail.com",
        "ascAppId": "6756059634",
        "appleTeamId": "6WULBZ4X7W"
      }
    }
  }
}