# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native — générés par prebuild (CNG / EAS Build)
android/
ios/

# Native credentials
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Google Services — injectés via secrets EAS
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local env files (feature flags, dev URLs, secrets)
.env
.env.local
.env.*.local
.env.development
.env.production

# typescript
*.tsbuildinfo
