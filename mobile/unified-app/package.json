{
  "name": "lirie-unified-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "maps:android-check": "node scripts/print-android-maps-setup.js",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "vercel-build": "expo export --platform web",
    "prebuild": "expo prebuild --clean",
    "build:dev": "eas build -p android --profile development",
    "build:dev:ios": "eas build -p ios --profile development",
    "build:dev:all": "eas build -p all --profile development",
    "build:prod": "npm run build:prod:preflight && eas build -p android --profile production",
    "build:prod:ios": "npm run build:prod:preflight && eas build -p ios --profile production",
    "build:prod:all": "npm run build:prod:preflight && eas build -p all --profile production",
    "build:prod:preflight": "npm run test:gps-critical && npm run typecheck:tracking && npm run typecheck:session-lifecycle && npm run check-build-ready && npm test -- --watchAll=false --testPathPattern=otaAutoReloadPolicy",
    "submit:prod:android": "npm run build:prod:preflight && eas submit -p android --profile production --latest",
    "submit:prod:ios": "npm run build:prod:preflight && eas submit -p ios --profile production --latest",
    "check-build-ready": "node ./scripts/check-build-ready.js",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "typecheck:session-lifecycle": "node ./scripts/typecheckSessionLifecycle.cjs",
    "typecheck:tracking": "node ./scripts/typecheckTracking.cjs",
    "test": "jest --watchAll=false",
    "test:gps-critical": "jest --watchAll=false --runInBand --forceExit --testPathPattern=\"(driverTrackingQueue(\\.|\\.p0|\\.http|\\.p03)|driverRealtimeBridge|localDriverLocationFreshness|fleetMapStale|trackingRuntimeRegistry|trackingQueueStore)\"",
    "sync:fleet-markers": "node scripts/syncFleetLirieMarkerPngs.mjs",
    "check:fleet-map-no-runtime-resolve": "node scripts/checkFleetMapNoRuntimeResolve.mjs",
    "preflight:ota-fleet-map": "npm run check:fleet-map-no-runtime-resolve && npm test -- --watchAll=false --testPathPattern=resolveMetroAssetSource && npm test -- --watchAll=false --testPathPattern=fleetNativeMarkerImage",
    "update:prod:ios": "node ./scripts/easUpdateProd.cjs --platform ios",
    "update:prod:android": "node ./scripts/easUpdateProd.cjs --platform android",
    "update:prod:all": "node ./scripts/easUpdateProd.cjs --platform all",
    "update:prod:unsafe": "eas update --branch production",
    "no-legacy-imports": "node ./scripts/noLegacyImports.cjs",
    "no-allow-font-scaling-false": "node ./scripts/noAllowFontScalingFalse.cjs",
    "audit:layout-magic-numbers": "node ./scripts/auditMagicLayoutNumbers.cjs",
    "audit:layout-font-sizes": "node ./scripts/auditLayoutFontSizes.cjs",
    "check-instrumentation-events": "node ./scripts/checkInstrumentationEvents.cjs",
    "check:play-compliance": "node ./scripts/check-play-compliance.cjs",
    "prefill-pilot-log": "node ./scripts/prefillPilotExecutionLog.cjs",
    "prefill-pilot-log:dry-run": "node ./scripts/prefillPilotExecutionLog.cjs --dry-run",
    "phase1:harden-committee": "node ./scripts/hardenPhase1Committee.cjs",
    "phase1:harden-committee:dry-run": "node ./scripts/hardenPhase1Committee.cjs --dry-run",
    "phase1:harden-committee:strict": "node ./scripts/hardenPhase1Committee.cjs --strict",
    "phase1:harden-committee:strict-release": "node ./scripts/hardenPhase1Committee.cjs --strict-release",
    "phase2:close-auth": "node ./scripts/phase2CloseAuthorization.cjs",
    "phase2:close-auth:dry-run": "node ./scripts/phase2CloseAuthorization.cjs --dry-run",
    "phase2:close-auth:strict": "node ./scripts/phase2CloseAuthorization.cjs --strict"
  },
  "dependencies": {
    "@expo-google-fonts/philosopher": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/messaging": "^23.8.6",
    "@react-navigation/native": "^7.1.6",
    "@sentry/react-native": "~7.2.0",
    "@tanstack/react-query": "^5.99.0",
    "axios": "^1.18.1",
    "dayjs": "^1.11.13",
    "expo": "~54.0.35",
    "expo-application": "~7.0.7",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-background-fetch": "~14.0.9",
    "expo-background-task": "~1.0.10",
    "expo-battery": "~10.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "^17.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.8",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.18",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "formik": "^2.4.6",
    "lottie-react-native": "~7.3.1",
    "pngjs": "^7.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-map-clustering": "^4.0.0",
    "react-native-maps": "1.20.1",
    "react-native-maps-directions": "^1.9.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.1",
    "yup": "^1.6.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@jest/globals": "~29.7.0",
    "@napi-rs/wasm-runtime": "^0.2.12",
    "@resvg/resvg-js": "^2.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "~19.1.0",
    "eslint": "^9.32.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.preload.cjs",
      "<rootDir>/jest.setup.ts"
    ]
  },
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "expo-task-manager",
        "expo-location",
        "unimodules-app-loader"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@notifee/react-native"
        ]
      }
    }
  },
  "overrides": {
    "axios": "^1.18.1",
    "@xmldom/xmldom": "0.8.13",
    "protobufjs": ">=8.7.1",
    "lodash": "4.18.1",
    "follow-redirects": "^1.16.0",
    "uuid": "14.0.0",
    "postcss": "8.5.23",
    "@tootallnate/once": "3.0.1",
    "fast-uri": ">=4.1.2",
    "js-yaml": "^4.3.0",
    "shell-quote": ">=1.9.0",
    "ws": "8.21.0",
    "@grpc/grpc-js": ">=1.9.16",
    "tar": ">=7.5.19",
    "form-data": ">=4.0.6",
    "undici": ">=7.29.0",
    "socket.io-parser": "4.2.7",
    "websocket-driver": ">=0.7.5",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.9",
    "@isaacs/brace-expansion": ">=5.0.1"
  }
}

