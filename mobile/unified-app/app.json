{
  "expo": {
    "name": "Lirie",
    "slug": "operations-app",
    "version": "1.0.10",
    "runtimeVersion": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lirie",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "ch.liri.operations",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.lirie.ch",
              "pathPrefix": "/activate-account"
            },
            {
              "scheme": "https",
              "host": "app.lirie.ch",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 124
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ch.liri.operations",
      "buildNumber": "68",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:app.lirie.ch"
      ],
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr_CH",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "location",
          "processing"
        ],
        "LSApplicationQueriesSchemes": [
          "tel",
          "comgooglemaps"
        ],
        "NSLocationWhenInUseUsageDescription": "La localisation permet le suivi temps réel des missions en cours et, lorsque vous êtes disponible pendant la plage opérationnelle (07h–19h), la visibilité sur la carte dispatch de votre entreprise.",
        "NSLocationAlwaysUsageDescription": "La localisation en arrière-plan permet le suivi des missions lorsque l'écran est verrouillé et, lorsque vous êtes disponible pendant la plage opérationnelle (07h–19h), la visibilité flotte pour le dispatch.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "La localisation en arrière-plan permet le suivi des missions lorsque l'écran est verrouillé et, lorsque vous êtes disponible pendant la plage opérationnelle (07h–19h), la visibilité flotte pour le dispatch.",
        "NSPhotoLibraryUsageDescription": "L'accès aux photos permet d'envoyer des pièces jointes dans le chat.",
        "NSCameraUsageDescription": "L'accès à la caméra permet de prendre des photos pour les missions.",
        "NSMicrophoneUsageDescription": "Le micro sert à enregistrer des messages vocaux dans le chat."
      },
      "config": {
        "googleMapsApiKey": "",
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF3F1",
          "image": "./assets/images/splash-solid.png",
          "imageWidth": 128,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "classpath": "com.google.gms:google-services:4.4.2"
          },
          "ios": {
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging"
            ]
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./prebuild-mods/withIosFirebaseModularHeaders.js",
      "./prebuild-mods/withAndroidIconBackground.js",
      "./prebuild-mods/withAndroidGoogleMapsKey.js",
      "./prebuild-mods/withAndroidTrackingForegroundService.js",
      "expo-router",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "La localisation permet le suivi opérationnel des missions en cours, y compris lorsque l'écran est verrouillé.",
          "androidForegroundServiceIcon": "./assets/images/icon.png"
        }
      ],
      "expo-task-manager",
      "expo-background-task",
      "expo-background-fetch",
      "expo-secure-store",
      "expo-sqlite",
      "expo-local-authentication",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'accès aux photos permet d'envoyer des pièces jointes dans le chat.",
          "cameraPermission": "L'accès à la caméra permet de prendre des photos pour les missions."
        }
      ],
      "expo-document-picker",
      "expo-updates",
      [
        "@sentry/react-native/expo",
        {
          "organization": "lirie",
          "project": "lirie-mobile"
        }
      ],
      "expo-audio",
      "expo-video"
    ],
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3be107c7-29d2-4987-91a0-8d7c31604891"
      }
    },
    "owner": "drinjasiqi",
    "updates": {
      "url": "https://u.expo.dev/3be107c7-29d2-4987-91a0-8d7c31604891",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000
    }
  }
}
