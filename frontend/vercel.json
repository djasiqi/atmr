{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/demo/:path*",
      "destination": "https://api.lirie.ch/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.lirie.ch/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://api.lirie.ch/socket.io/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "https://api.lirie.ch/socket.io"
    },
    {
      "source": "/uploads/company_logos/:path*",
      "destination": "https://api.lirie.ch/uploads/company_logos/:path*"
    },
    {
      "source": "/uploads/institution_logos/:path*",
      "destination": "https://api.lirie.ch/uploads/institution_logos/:path*"
    }
  ]
}
