    "@react-google-maps/api": "^2.20.8",
    "@reduxjs/toolkit": "^2.5.0",
    "@sentry/react": "^10.25.0",
    "@tanstack/react-query": "^5.67.1",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.18.1",
    "browserify-zlib": "^0.2.0",
    "cra-template": "1.2.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "exif-js": "^2.3.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.24",
    "jwt-decode": "^4.0.0",
    "path-browserify": "^1.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.16.0",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-app-rewired": "^2.2.1",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.4.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.1",
    "react-slick": "^0.30.3",
    "react-toastify": "^11.0.5",
    "react-window": "^2.2.1",
    "react-yearly-calendar": "^1.2.6",
    "recharts": "^2.15.1",
    "redux": "^5.0.1",
    "slick-carousel": "^1.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.3",
    "stream-browserify": "^3.0.0",
    "swissqrbill": "^4.1.1",
    "util": "^0.12.5",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "build:react": "react-app-rewired build",
    "prerender": "node scripts/prerender-public-pages.mjs",
    "test:seo-build": "node scripts/validate-prerendered-html.mjs",
    "test:seo-smoke": "node scripts/seo-preview-smoke.mjs",
    "build": "npm run build:react && npm run prerender",
    "test": "react-scripts test",
    "test:ci": "CI=true react-scripts test --coverage --watchAll=false",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "e2e:demo": "playwright test e2e/demo-commercial.spec.js",
    "e2e:institution-billing-g3": "playwright test --config=playwright.institution-billing.config.js",
    "e2e:dashboard-targeted-audit": "node scripts/collect-dashboard-targeted-audit.mjs",
    "e2e:dashboard-targeted-audit:merge": "node scripts/merge-targeted-audit-summary.mjs",
    "e2e:company-space-baseline": "node scripts/collect-company-space-baseline.mjs",
    "e2e:company-space-baseline:30": "node scripts/collect-company-space-baseline.mjs --mode=prod-build --runs=30",
    "analyze:bundle": "npm run build && source-map-explorer \"build/static/js/*.js\" --html build-analyze.html --json build-analyze.json",
    "eject": "react-scripts eject",
    "lint": "eslint .",
    "update-deps": "npm update",
    "audit-fix": "npm audit fix",
    "fix-glob": "node ./scripts/update-glob.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "rules": {
      "no-console": "off",
      "no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(axios|date-fns|@mui|slick-carousel)/)"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}",
      "<rootDir>/tests/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "moduleNameMapper": {
      "^@atmr/google-maps-bootstrap$": "<rootDir>/src/shared/google-maps/bootstrap.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^services/(.*)$": "<rootDir>/src/services/$1",
      "^hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^utils/(.*)$": "<rootDir>/src/utils/$1",
      "^components/(.*)$": "<rootDir>/src/components/$1",
      "^pages/(.*)$": "<rootDir>/src/pages/$1",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@playwright/test": "^1.58.2",
    "@sparticuz/chromium": "^147.0.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "ajv": "^8.17.1",
    "baseline-browser-mapping": "^2.9.11",
    "http-proxy-middleware": "3.0.7",
    "msw": "^2.11.5",
    "playwright-core": "^1.62.0",
    "react-scripts": "^5.0.1",
    "redux-mock-store": "^1.5.5",
    "source-map-explorer": "^2.5.3",
    "webpack-bundle-analyzer": "^5.1.1",
    "workbox-webpack-plugin": "^7.4.0"
  },
  "overrides": {
    "socket.io-parser": "4.2.7",
    "flatted": ">=3.4.2",
    "serialize-javascript": "7.0.5",
    "underscore": ">=1.13.8",
    "qs": "6.15.2",
    "brace-expansion": "5.0.9",
    "ws": "8.21.0",
    "nth-check": "^2.1.1",
    "postcss": "8.5.23",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "webpack-dev-server": {
      ".": "^5.2.6",
      "http-proxy-middleware": "3.0.7"
    },
    "http-proxy-middleware": "3.0.7",
    "rollup": "^2.80.0",
    "@sentry/browser": "^8.47.0",
    "glob": "^11.1.0",
    "node-forge": ">=1.3.2",
    "@isaacs/brace-expansion": ">=5.0.1",
    "minimatch": "10.2.5",
    "@tootallnate/once": "3.0.1",
    "axios": "^1.18.1",
    "follow-redirects": "^1.16.0",
    "lodash": "4.18.1",
    "path-to-regexp": "0.1.13",
    "uuid": "14.0.0",
    "fast-uri": ">=4.1.2",
    "react-router": ">=7.18.2",
    "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
    "tmp": ">=0.2.6",
    "form-data": ">=4.0.6",
    "shell-quote": ">=1.9.0",
    "@babel/core": ">=7.29.7",
    "launch-editor": ">=2.14.1",
    "websocket-driver": ">=0.7.5",
    "svgo": "2.8.3",
    "body-parser": ">=1.20.6"
  },
  "_comment": {
    "glob-override": "Override glob to ^11.1.0 to fix GHSA-ww39-953v-wcq6 (command injection in CLI -c/--cmd option). This forces all transitive dependencies (react-scripts, etc.) to use the patched version. See: https://github.com/isaacs/node-glob/security/advisories/GHSA-ww39-953v-wcq6",
    "minimatch-override": "Override minimatch to ^10.2.1 to fix ReDoS CVE (exceljs, react-scripts, source-map-explorer pull 10.x).",
    "underscore-override": "Override underscore to >=1.13.8 to fix GHSA-114 (unlimited recursion DoS in _.flatten/_.isEqual). Transitive via react-scripts.",
    "jsonpath-risk": "jsonpath 1.1.1 (via react-scripts) has CVE-2026-1615 (arbitrary code injection). No patch available. jsonpath-plus is not API-compatible. Risk mitigated: react-scripts uses it for internal config only, not user input. Consider migrating to Vite long-term.",
    "axios-lodash-path-override": "axios 1.18.1+, lodash 4.18.1, follow-redirects 1.16+, path-to-regexp 0.1.13 (GHSA axios proxy/DoS/prototype, lodash, ReDoS express).",
    "socket-io-parser-override": "Force 4.2.7+ for GHSA-2m8v-j782-fhvr (CVE-2026-69185 zero-attachment DoS) + GHSA-677m-j7p3-52f9.",
    "flatted-override": "Force >=3.4.2 for GHSA-rf6f-7fwh-wjgh (prototype pollution in parse).",
    "tmp-override": "Force >=0.2.6 for GHSA-ph9p-34f9-6g65 (path traversal via unsanitized prefix/postfix). Transitive via source-map-explorer/external-editor.",
    "security-audit-2026-07": "shell-quote >=1.9.0, js-yaml ^4.3.0, fast-uri >=3.1.4, brace-expansion 5.0.8, postcss 8.5.23, react-router-dom 7.18.1, websocket-driver >=0.7.5, svgo 2.8.3, webpack-dev-server ^5.2.6, axios ^1.18.1, body-parser >=1.20.6."
  }
}
