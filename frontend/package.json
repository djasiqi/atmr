{
  "name": "frontend",
  "description": "Final fix for dependencies",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@craco/craco": "^5.9.0",
    "@date-io/date-fns": "^3.2.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@mapbox/polyline": "^1.2.1",
    "@mui/material": "^7.1.2",
    "@mui/x-date-pickers": "^8.5.3",
    "@react-google-maps/api": "^2.20.8",
    "@reduxjs/toolkit": "^2.5.0",
    "@sentry/react": "^10.25.0",
    "@tanstack/react-query": "^5.67.1",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.13.5",
    "browserify-zlib": "^0.2.0",
    "cra-template": "1.2.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "exif-js": "^2.3.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.24",
    "jwt-decode": "^4.0.0",
    "path-browserify": "^1.0.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.16.0",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-app-rewired": "^2.2.1",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.4.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.3",
    "react-select": "^5.10.1",
    "react-slick": "^0.30.3",
    "react-toastify": "^11.0.5",
    "react-window": "^2.2.1",
    "react-yearly-calendar": "^1.2.6",
    "recharts": "^2.15.1",
    "redux": "^5.0.1",
    "slick-carousel": "^1.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.3",
    "stream-browserify": "^3.0.0",
    "swissqrbill": "^4.1.1",
    "util": "^0.12.5",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "build": "react-app-rewired build",
    "test": "react-scripts test",
    "test:ci": "CI=true react-scripts test --coverage --watchAll=false",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "e2e:demo": "playwright test e2e/demo-commercial.spec.js",
    "eject": "react-scripts eject",
    "lint": "eslint .",
    "update-deps": "npm update",
    "audit-fix": "npm audit fix",
    "fix-glob": "node ./scripts/update-glob.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "rules": {
      "no-console": "off",
      "no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(axios|date-fns|@mui|slick-carousel)/)"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}",
      "<rootDir>/tests/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "moduleNameMapper": {
      "^services/(.*)$": "<rootDir>/src/services/$1",
      "^hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^utils/(.*)$": "<rootDir>/src/utils/$1",
      "^components/(.*)$": "<rootDir>/src/components/$1",
      "^pages/(.*)$": "<rootDir>/src/pages/$1",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "ajv": "^8.17.1",
    "baseline-browser-mapping": "^2.9.11",
    "http-proxy-middleware": "^3.0.5",
    "msw": "^2.11.5",
    "react-scripts": "^5.0.1",
    "redux-mock-store": "^1.5.5",
    "source-map-explorer": "^2.5.3",
    "webpack-bundle-analyzer": "^5.1.1"
  },
  "overrides": {
    "serialize-javascript": "7.0.3",
    "underscore": ">=1.13.8",
    "qs": "6.14.1",
    "nth-check": "^2.1.1",
    "postcss": "^8.4.49",
    "js-yaml": "^4.1.0",
    "webpack-dev-server": "^5.2.2",
    "rollup": "^2.80.0",
    "@sentry/browser": "^8.47.0",
    "glob": "^11.1.0",
    "node-forge": ">=1.3.2",
    "@isaacs/brace-expansion": ">=5.0.1",
    "minimatch": "^10.2.1"
  },
  "_comment": {
    "glob-override": "Override glob to ^11.1.0 to fix GHSA-ww39-953v-wcq6 (command injection in CLI -c/--cmd option). This forces all transitive dependencies (react-scripts, etc.) to use the patched version. See: https://github.com/isaacs/node-glob/security/advisories/GHSA-ww39-953v-wcq6",
    "minimatch-override": "Override minimatch to ^10.2.1 to fix ReDoS CVE (exceljs, react-scripts, source-map-explorer pull 10.x).",
    "underscore-override": "Override underscore to >=1.13.8 to fix GHSA-114 (unlimited recursion DoS in _.flatten/_.isEqual). Transitive via react-scripts.",
    "jsonpath-risk": "jsonpath 1.1.1 (via react-scripts) has CVE-2026-1615 (arbitrary code injection). No patch available. jsonpath-plus is not API-compatible. Risk mitigated: react-scripts uses it for internal config only, not user input. Consider migrating to Vite long-term."
  }
}
