# Gabarit pour le build CRA en production (copier vers .env.production ou injecter les mêmes clés en CI).
# Ne pas committer .env.production avec des secrets (Maps, Sentry) — utiliser les secrets CI / hébergeur.
# Préfixe REACT_APP_ obligatoire ; valeurs figées au moment du npm run build.

# API (une des deux ; companyService / axios)
REACT_APP_API_BASE_URL=https://api.lirie.ch/api/v1

# Socket.IO entreprise — même origine HTTPS que l’API (voir src/services/companySocket.js)
REACT_APP_SOCKET_URL=https://api.lirie.ch

REACT_APP_SOCKET_ENABLED=true

# Optionnel — cartes Google (variable côté build / secret CI)
# REACT_APP_GOOGLE_MAPS_API_KEY=

# Optionnel — Sentry
# REACT_APP_SENTRY_DSN=
# REACT_APP_SENTRY_ENVIRONMENT=production

# Feature : GET fusionné drivers/live (activer seulement si backend + ops validés)
# REACT_APP_DRIVERS_LIVE_API=1
