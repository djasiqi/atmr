# Gabarit staging GPS isolé — copier vers .env.staging (gitignoré).
# INTERDIT : copier l'env de prod, coller des URL publiques prod, brokers/volumes prod.
#
#   bash scripts/staging/init-env.sh
#
# Image CI (Build & Deploy skip_deploy=true) : tag sha-<12> du commit.
# SHA complet : 26338ec0e0f124bac7b253b067970e08530aec3f
STAGING_BACKEND_IMAGE=docker.io/djasiqi/atmr-backend:sha-26338ec0e0f1

APP_ENV=staging
FLASK_CONFIG=production
FLASK_ENV=production
FLASK_APP=app.py

# Firewall : OFF par défaut. Observe n'est JAMAIS implicite.
TRACKING_MISSION_FIREWALL_MODE=off

POSTGRES_USER=atmrstg
POSTGRES_PASSWORD=CHANGE_ME_GENERATE
POSTGRES_DB=atmrstg
POSTGRES_SSLMODE=disable

SECRET_KEY=CHANGE_ME_GENERATE
JWT_SECRET_KEY=CHANGE_ME_GENERATE
APP_ENCRYPTION_KEY_B64=CHANGE_ME_GENERATE
MASTER_ENCRYPTION_KEY=CHANGE_ME_GENERATE

PDF_BASE_URL=http://127.0.0.1:15000
SOCKETIO_CORS_ORIGINS=http://127.0.0.1:15000

KAFKA_ENABLED=true
TRACKING_INGEST_ASYNC_ENABLED=true
TRACKING_INGEST_PERSIST_ENABLED=true
TRACKING_SOCKET_KAFKA_MIRROR_ENABLED=false
TRACKING_PROCESSED_FANOUT_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_DRIVER_LOCATION_RAW=driver.location.raw
KAFKA_TOPIC_DRIVER_LOCATION_PROCESSED=driver.location.processed
KAFKA_TOPIC_DRIVER_LOCATION_DLQ=driver.location.dlq
KAFKA_TRACKING_CONSUMER_GROUP=atmrstg-tracking-ingest

HIBP_ENABLED=false
INTERNAL_TRACKING_INGEST_ENABLED=false
DRIVER_LOCATION_METRICS_ENABLED=true
STANDALONE_PROMETHEUS_ENABLED=true
TRACKING_CONSUMER_METRICS_PORT=9115

GIT_SHA=26338ec0e0f124bac7b253b067970e08530aec3f
API_GIT_SHA=26338ec0e0f124bac7b253b067970e08530aec3f
SENTRY_DSN=
SENTRY_RELEASE=staging-26338ec0

GUNICORN_WORKERS=1
GUNICORN_WORKER_CLASS=gevent
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
