# =============================================================================
# Secrets prod locaux — scripts/env.production.local.fragment (NON versionné)
# =============================================================================
# Copier vers scripts/env.production.local.fragment (gitignore) :
#   cp scripts/env.production.local.fragment.example scripts/env.production.local.fragment
#
# Sur le serveur prod : placer le même fichier sous /srv/atmr/scripts/
# (non écrasé par le SCP CI — deploy-production.sh le fusionne à chaque deploy).
#
# Lu AVANT docker compose pull (export shell) puis appendé à .env.production.
# Priorité recommandée : secret GitHub INTERNAL_SERVICE_TOKEN (deploy.yml).
# Alternative serveur : ce fragment ou .env.production.local
# =============================================================================

# F-01 — ingestion GPS interne ws-service → backend (min 32 caractères)
# Générer : openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# Rotation dual-token (backend uniquement, optionnel)
# INTERNAL_SERVICE_TOKEN_NEXT=
