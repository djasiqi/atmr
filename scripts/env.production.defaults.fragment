# =============================================================================
# Fragment appendu à .env.production par deploy-production.sh (après le bloc CI).
# Pas de secrets ici — défauts prod Lirie + perf / contact / cookies / rate limit.
# Ces valeurs remplacent l’usage de secrets GitHub dupliqués pour les mêmes rôles.
# Surcharges sensibles : /srv/atmr/.env.production.local (fusionné en fin de script).
# =============================================================================

# --- Brevo (mode API vs SMTP factures) — distinct de EMAIL_PROVIDER=brevo (bloc CI) ---
EMAIL_PROVIDER_MODE=brevo_api

# --- URLs publiques (alignées Traefik / api.lirie.ch) ---
FRONTEND_URL=https://www.lirie.ch/
DEMO_MAGIC_LINK_BASE_URL=https://www.lirie.ch/demo-access/consume
PDF_PUBLIC_BASE_URL=https://api.lirie.ch
PUBLIC_BASE_URL=https://api.lirie.ch
UPLOADS_PUBLIC_BASE=/uploads

# --- Saferpay (JSON API) : identifiants = secrets CI uniquement ---
# Sandbox / temps réel de test contre l’API Saferpay test (sans secret ici).
SAFERPAY_API_BASE_URL=https://test.saferpay.com/api
SAFERPAY_ALLOW_TEST_API_IN_PRODUCTION=1

# --- Formulaire contact (backend/services/contact/dispatcher.py) ---
# CONTACT_EMAIL_DEFAULT / CONTACT_EMAIL_DEMO viennent du bloc CI ; ici le détail par catégorie.
CONTACT_EMAIL_SUPPORT=support@lirie.ch
CONTACT_EMAIL_INSTITUTION=institution@lirie.ch
CONTACT_EMAIL_TRANSPORT=entreprise@lirie.ch
CONTACT_EMAIL_BILLING=facturation@lirie.ch
CONTACT_EMAIL_FAMILY=famille@lirie.ch

CONTACT_FROM_EMAIL_SUPPORT=support@lirie.ch
CONTACT_FROM_EMAIL_INSTITUTION=institution@lirie.ch
CONTACT_FROM_EMAIL_TRANSPORT=entreprise@lirie.ch
CONTACT_FROM_EMAIL_DEMO=demo@lirie.ch
CONTACT_FROM_EMAIL_BILLING=facturation@lirie.ch
CONTACT_FROM_EMAIL_FAMILY=famille@lirie.ch

CONTACT_AUTOREPLY_ENABLED=true
CONTACT_AUTOREPLY_FROM_EMAIL=noreply@lirie.ch
CONTACT_AUTOREPLY_FROM_NAME=LIRIE
CONTACT_AUTOREPLY_LOGO_URL=https://www.lirie.ch/logo-lirie.png

# --- Cookies & session (HTTPS ; aligné docker-compose.production.yml) ---
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
COOKIE_HTTP_ONLY=true
COOKIE_PATH=/
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
REMEMBER_COOKIE_SECURE=true
REMEMBER_COOKIE_SAMESITE=Lax

# --- JWT durées (secondes) — complète JWT_MOBILE_* / JWT_DECODE_LEEWAY du bloc CI ---
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRES_SECONDS=7776000
# Sessions refresh actives par rôle (company/institution : multi-appareils mobile)
MAX_ACTIVE_REFRESH_TOKENS_COMPANY=15

# --- SQLAlchemy / perf requêtes ---
SQLALCHEMY_QUERY_TIMEOUT=5.0
SQLALCHEMY_ECHO=false
SQLALCHEMY_RECORD_QUERIES=false

# --- Observabilité (charge prod : traces Sentry modérées) ---
LOG_LEVEL=INFO
SENTRY_TRACES_SAMPLE_RATE=0.1
WERKZEUG_LOG_LEVEL=ERROR

# --- Rate limiting (Redis) — aligné backend/config.py ProductionConfig ---
RATELIMIT_STRATEGY=moving-window
RATELIMIT_CONFIG_VERSION=v1
RATELIMIT_KEY_TTL=7200
RATELIMIT_DEFAULT_LIMITS="1000 per hour"
RATELIMIT_DISPATCH_RUN="30 per hour"
RATELIMIT_DISPATCH_TRIGGER="50 per hour"
RATELIMIT_COMPANY_DISPATCH_RUN="10 per minute"
RATELIMIT_COMPANY_DISPATCH_OPTIMIZER="10 per minute"

# --- Socket.IO (obligatoire prod — sans cela Gunicorn quitte au démarrage → 502) ---
SOCKETIO_CORS_ORIGINS=https://www.lirie.ch,https://lirie.ch,https://api.lirie.ch

# --- Phase 2 WebSocket split (docs/ops/ws-service-canary.md) ---
# Dogfood / canary PR C : le backend legacy Socket.IO reste actif jusqu'à PR D.
SKIP_SOCKETIO=false
WS_RELAY_PUBLISH_ENABLED=true
WS_SERVICE_ACCEPT_CONNECTIONS=true
EXPO_PUBLIC_WS_CANARY_ENABLED=1
EXPO_PUBLIC_WS_CANARY_HEADER_VALUE=1
# PR D (REST pur, ne pas activer avant bascule) : SKIP_SOCKETIO=true, GUNICORN_WORKER_CLASS=gthread, GUNICORN_THREADS=4

# --- Localisation chauffeur (LIRIE perf / Redis / observabilité) — pas de secret ---
# Référence complète : backend/env.example § localisation + rate limit HTTP PUT.
DRIVER_LOCATION_METRICS_ENABLED=true
LOCATION_CORRELATION_LOGS=0
# TTL clés géoloc Redis (s) — défaut code 1200 si absent
# DRIVER_LOC_TTL_SEC=1200
# Idempotence location_event_id / namespace Redis (dédup P0)
# DRIVER_LOCATION_EVENT_ID_TTL_SEC=600
# DRIVER_LOCATION_REDIS_EVENT_NS=atmr:driver_location:event
# Dédup proximité (mission_live : laisser false jusqu’à validation ops / métriques)
# DRIVER_LOCATION_PROXIMITY_DEDUP_ENABLED=true
# DRIVER_LOCATION_PROXIMITY_MAX_M=5
# DRIVER_LOCATION_PROXIMITY_MAX_SEC=5
DRIVER_LOCATION_PROXIMITY_MISSION_LIVE_ENABLED=false
# DRIVER_LOCATION_PROXIMITY_FRESHNESS_ADVANCE_SEC=1.0
# Rate limit PUT HTTP /driver/me/location (services/geolocation/driver_location_http.py)
# HTTP_DRIVER_LOCATION_REQ_PER_WINDOW=60
# HTTP_DRIVER_LOCATION_WINDOW_SEC=60
# HTTP_DRIVER_LOCATION_IDEMPOTENCY_TTL_SEC=300
# v21 / tenant (optionnel)
# DRIVER_LOCATION_V21_ENABLED=true
# DRIVER_LOCATION_V21_TENANT_OVERRIDES=123:false,456:true
# Métriques GET /driver/me/bookings/since (header X-LIRIE-Sync-Trigger) : pas de variable d’env.

# =============================================================================
# --- Kafka (brokers démarrés via scripts/deploy-kafka-production.sh) ---
# =============================================================================
# Décision plan « validation prod tracking BG » 2026-06-02 : Kafka REQUIS en prod.
# Brokers via docker-compose.kafka.yml + docker-compose.kafka.atmr-network.yml (--profile kafka).
#
# Pour rebasculer toute la stack en mode sans Kafka : repasser les 4 flags à false ET arrêter
# les consumers (`docker compose --profile kafka down tracking-kafka-consumer …`).

# 1) Flags d'activation principaux — VÉRIFIÉS PAR LE PREFLIGHT
#    `kafka_check_flags_all_true` (scripts/lib/kafka_checks.sh) refuse `deploy-kafka-production.sh`
#    si l'un des 5 n'est pas à `true`. Les 5 doivent évoluer ensemble en prod normale.
#    - KAFKA_ENABLED              : producer/consumer Kafka activés côté backend
#                                   (services/{kafka,notifications,tracking}/*.py)
#    - TRACKING_INGEST_ASYNC_ENABLED      : routes/driver.py PUT /location publie sur Kafka
#                                          (sinon insertion DB synchrone)
#    - TRACKING_PROCESSED_FANOUT_ENABLED  : tracking-processed-fanout consume processed
#                                          → fanout SocketIO (sinon path HTTP sync)
#    - WS_KAFKA_CONSUMER_ENABLED          : ws-service consume mission/processed events
#    - TRACKING_INGEST_PERSIST_ENABLED      : consumer ingest persiste en DB (5e flag preflight)
KAFKA_ENABLED=true
TRACKING_INGEST_ASYNC_ENABLED=true
TRACKING_PROCESSED_FANOUT_ENABLED=true
WS_KAFKA_CONSUMER_ENABLED=true

# 2) Bootstrap & sécurité (réseau Docker interne via atmr-network)
KAFKA_BOOTSTRAP_SERVERS=kafka-broker-1:29092,kafka-broker-2:29092,kafka-broker-3:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# SASL/SSL : uniquement si broker managé externe (Confluent Cloud, MSK, etc.)
# Surcharger via .env.production.local. Laisser vides en prod interne.
# KAFKA_SASL_MECHANISM=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CAFILE=
# KAFKA_SSL_CERTFILE=
# KAFKA_SSL_KEYFILE=

# 3) Réplication & ISR — RF=2 (brokers 1–3 alignés via docker-compose.kafka.yml)
KAFKA_BROKER_REPLICATION_FACTOR=2
KAFKA_TOPIC_REPLICATION_FACTOR=2
KAFKA_BROKER_MIN_INSYNC_REPLICAS=1
KAFKA_BROKER_TXN_MIN_ISR=1

# 3b) Optimisation LIRIE — partitions & topics (voir docs/ops/kafka-optimization-lirie.md)
KAFKA_COMPOSE_FILE=docker-compose.kafka.yml
KAFKA_DEFAULT_PARTITIONS=6
KAFKA_DLQ_PARTITIONS=3
KAFKA_CREATE_INACTIVE_TOPICS=false
# Phase 1 migration v2 (6 partitions) — actif après compose optimisé déployé
KAFKA_TOPIC_DRIVER_LOCATION_RAW=driver.location.raw.v2
KAFKA_TOPIC_DRIVER_LOCATION_PROCESSED=driver.location.processed.v2
KAFKA_TOPIC_DRIVER_LOCATION_DLQ=driver.location.dlq.v2

# 4) Bootstrap retry (services/kafka/bootstrap_retry.py + ws-service/main.py)
#    Tolérance au démarrage si un broker tarde à devenir healthy.
KAFKA_BOOTSTRAP_MAX_ATTEMPTS=5
KAFKA_BOOTSTRAP_MAX_BACKOFF_SEC=10

# 5) Consumer groups (déjà alignés sur les défauts code, expliciter pour audit)
KAFKA_TRACKING_CONSUMER_GROUP=tracking-ingest-consumer-group
KAFKA_PROCESSED_FANOUT_GROUP=tracking-processed-fanout-group
KAFKA_DLQ_CONSUMER_GROUP=kafka-dlq-consumer-group
WS_KAFKA_GROUP_ID=ws-service-shared

# 5b) Métriques Prometheus — consumer ingest GPS (latence E2E raw→processed)
#     Scrapé par monitoring/prometheus/prometheus.yml (job atmr-tracking-kafka-consumer).
#     Ne pas confondre avec /api/v1/prometheus/metrics du backend Flask.
TRACKING_CONSUMER_METRICS_PORT=9115

# 5b2) Métriques Prometheus — consumer fanout processed (P1-1b)
#      Scrapé par monitoring/prometheus/prometheus.yml (job atmr-tracking-processed-fanout).
TRACKING_FANOUT_METRICS_PORT=9116

# 5c) OSRM snap timeout (P0-3) — verrouillé explicitement en prod.
#     OSRM_SNAP_TIMEOUT_S borne chaque snap par record (doit rester < KAFKA_PUBLISH_ACK_TIMEOUT_S=2).
#     OSRM_SNAP_TIMEOUT_ENABLED=false = kill-switch granulaire de rollback (garde la persistance,
#     neutralise le timeout) distinct de TRACKING_INGEST_PERSIST_ENABLED=false.
OSRM_SNAP_TIMEOUT_S=1.5
OSRM_SNAP_TIMEOUT_ENABLED=true

# 5d) Métrique de lag consumer (P1-1a) — garde-fou avant activation persistance GPS.
#     TRACKING_KAFKA_LAG_METRIC_ENABLED=false court-circuite le calcul (rollback si surcharge broker).
TRACKING_KAFKA_LAG_METRIC_ENABLED=true

# 5e) Persistance GPS dans ingest_consumer (P0-2) — STOP GATE levé après validation lag=0.
#     Le consumer persiste en DB (UpdateDriverLocationUseCase: OSRM snap + DB + Redis) puis republie.
#     Rollback republish-only : TRACKING_INGEST_PERSIST_ENABLED=false ET
#     TRACKING_INGEST_ALLOW_REPUBLISH_ONLY=true (sinon le consumer refuse de démarrer — garde-fou C).
#     Rollback granulaire OSRM : OSRM_SNAP_TIMEOUT_ENABLED=false. Voir docs/ops/gps-tracking-pipeline.md.
TRACKING_INGEST_PERSIST_ENABLED=true
# TRACKING_INGEST_ALLOW_REPUBLISH_ONLY=true  # uniquement rollback intentionnel (republish sans DB)

# 6) Opt-ins ws-service (défauts compose) — laisser tels quels en phase de stabilisation
#    WS_KAFKA_ENABLE_MISSION_EVENTS : à passer à true plus tard quand pipeline stable.
#    WS_KAFKA_SEEK_TO_END_ON_START  : true évite de rejouer le backlog au boot.
WS_KAFKA_ENABLE_MISSION_EVENTS=false
WS_KAFKA_SEEK_TO_END_ON_START=true

# --- Postgres / Redis (réseau Docker interne) ---
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Après reboot : Redis peut rester en LOADING (RDB/AOF). Healthcheck compose + retries applicatives.
# Backend (docker-entrypoint) : REDIS_STARTUP_MAX_ATTEMPTS / REDIS_STARTUP_RETRY_SLEEP_SEC
# ws-service : WS_REDIS_STARTUP_MAX_ATTEMPTS / WS_REDIS_STARTUP_RETRY_SLEEP_SEC
# REDIS_STARTUP_MAX_ATTEMPTS=90
# REDIS_STARTUP_RETRY_SLEEP_SEC=2
# WS_REDIS_STARTUP_MAX_ATTEMPTS=90
# WS_REDIS_STARTUP_RETRY_SLEEP_SEC=2

# --- Celery ---
CELERY_CONCURRENCY=4
CELERY_TIMEZONE=Europe/Zurich
# Après validation D1 (mémoire cgroup worker/Flower) : plafond RSS par enfant en kilooctets (Ko). 0=désactivé.
# Déploiement D2 : définir sur staging puis prod après 24h stables sans OOM (voir monitoring/README.md).
# CELERY_WORKER_MAX_MEMORY_PER_CHILD=300000
# CELERY_WORKER_MAX_TASKS_PER_CHILD=200

# --- Admin Ops (GET /api/v1/platform/status) ---
PLATFORM_STATUS_TIMEOUT_SECONDS=2.5
ADMIN_IP_WHITELIST_REQUIRED=false
PLATFORM_API_URL_PROD=https://api.lirie.ch
# PLATFORM_API_URL_DEMO=   # définir seulement si API démo publique dédiée
PLATFORM_LINK_GRAFANA=https://grafana.lirie.ch
PLATFORM_LINK_PROMETHEUS=https://prometheus.lirie.ch
PLATFORM_LINK_ALERTMANAGER=https://alertmanager.lirie.ch
# Monitoring Traefik BasicAuth (htpasswd hash, $ doubles dans .env pour docker-compose labels)
# MONITORING_BASIC_AUTH_USERS=lirie-ops:$$2y$$05$$...
# IP allowlist : traefik/dynamic.yml middleware monitoring-ipallow (pas de virgules dans labels Docker)

# --- API / sécurité (même logique que docker-compose.production.yml environment) ---
FLASK_APP=app.py
API_LEGACY_ENABLED=false
API_DOCS=off
SECURITY_2FA_ENABLED=false
IP_MASK_MODE=first_octet
AUDIT_LOG_RETENTION_DAYS=730

# --- Workers / RL (image prod standard sans stack RL lourde) ---
GUNICORN_WORKERS=6
# Gunicorn 26+ : ne pas utiliser eventlet (retiré). docker-compose.prod force gevent.
GUNICORN_WORKER_CLASS=gevent
SOCKETIO_ASYNC_MODE=gevent
RL_ENABLED=false
WITH_RL=false
RL_WORKER_URL=http://atmr-rl-worker:5000
ML_MODELS_PATH=/app/data/ml
RL_MODELS_PATH=/app/data/rl

# --- Firebase (chemin conteneur ; JSON monté sur l’hôte) ---
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# --- Notifications push — Remédiation P0/P1/P2 (docs/notifications/remediation-flags.md) ---
# P0 — Night mode : fuseau Europe/Paris (LIRIE FR/CH même fuseau jusqu’à P2 timezone driver).
NIGHT_MODE_TZ=Europe/Paris
# P0 — Circuit breaker FCM partagé (Redis ; aligné backend/services/notifications/fcm_redis_circuit_breaker.py).
FCM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
FCM_CIRCUIT_BREAKER_OPEN_SECONDS=60
FCM_CIRCUIT_BREAKER_WINDOW_SECONDS=60
# P0 — Retries FCM (inchangé vs défauts code).
FCM_RETRY_MAX_ATTEMPTS=3
FCM_RETRY_BASE_DELAY_MS=2000
# P1 — Lifecycle DeviceToken : colonnes last_push_success_at / consecutive_push_failures / last_push_error_code.
PUSH_DEVICE_TOKEN_LIFECYCLE_ENABLED=1
PUSH_DEVICE_TOKEN_STALE_DAYS=30
PUSH_DEVICE_TOKEN_MIN_FAILURES=5
# P2 — Kafka publish depuis Celery (opt-in séparé des 4 flags d'activation principaux).
# Pré-requis désormais satisfait avec KAFKA_ENABLED=true + brokers up. Conservé à false ici
# pour rampage progressif : passer à true UNIQUEMENT après que la Phase 2 du plan validation
# soit verte (consumer groups Stable + propagation E2E + 0 erreur DNS Kafka sur ≥ 1h).
NOTIFICATIONS_KAFKA_PUBLISH_ENABLED=false
# P2 — Kafka-first : fanout publie directement sur Kafka (fallback Celery direct sinon).
# Pré-requis : KAFKA_ENABLED=true + NOTIFICATIONS_KAFKA_PUBLISH_ENABLED=true + broker joignable.
# À activer après NOTIFICATIONS_KAFKA_PUBLISH_ENABLED=true et observation 24h sans régression.
PUSH_KAFKA_FIRST_ENABLED=false

# --- Portail institution (feature flags backend) ---
# Parcours multi-étapes (TransportRequest legs) — défaut code false si absent.
# Voir services/institutions/transport_request_legs_service.py
INSTITUTION_MULTI_STOP_ENABLED=true

# --- OPENWEATHER_API_KEY : secret → uniquement dans .env.production.local sur le serveur ---

# --- SMS activation compte (Twilio) ---
# SMS_NOTIFICATIONS_ENABLED + TWILIO_* : secrets GitHub ou .env.production.local
# (modèle : scripts/env.production.local.twilio.example)
ACTIVATION_SMS_TTL_MINUTES=5
ACTIVATION_SMS_MAX_ATTEMPTS=5
ACTIVATION_RESEND_COOLDOWN_SECONDS=60
ACTIVATION_RESEND_DAILY_LIMIT=10
ACTIVATION_SMS_LOCK_MINUTES=15
