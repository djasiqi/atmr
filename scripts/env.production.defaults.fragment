# =============================================================================
# Fragment appendu à .env.production par deploy-production.sh (après le bloc CI).
# Pas de secrets ici — défauts prod Lirie + perf / contact / cookies / rate limit.
# Ces valeurs remplacent l’usage de secrets GitHub dupliqués pour les mêmes rôles.
# Surcharges sensibles : /srv/atmr/.env.production.local (fusionné en fin de script).
# =============================================================================

# --- Brevo (mode API vs SMTP factures) — distinct de EMAIL_PROVIDER=brevo (bloc CI) ---
EMAIL_PROVIDER_MODE=brevo_api

# --- URLs publiques (alignées Traefik / api.lirie.ch) ---
FRONTEND_URL=https://www.lirie.ch/
DEMO_MAGIC_LINK_BASE_URL=https://www.lirie.ch/demo-access/consume
PDF_PUBLIC_BASE_URL=https://api.lirie.ch
PUBLIC_BASE_URL=https://api.lirie.ch
UPLOADS_PUBLIC_BASE=/uploads

# --- Formulaire contact (backend/services/contact/dispatcher.py) ---
# CONTACT_EMAIL_DEFAULT / CONTACT_EMAIL_DEMO viennent du bloc CI ; ici le détail par catégorie.
CONTACT_EMAIL_SUPPORT=support@lirie.ch
CONTACT_EMAIL_INSTITUTION=institution@lirie.ch
CONTACT_EMAIL_TRANSPORT=entreprise@lirie.ch
CONTACT_EMAIL_BILLING=facturation@lirie.ch
CONTACT_EMAIL_FAMILY=famille@lirie.ch

CONTACT_FROM_EMAIL_SUPPORT=support@lirie.ch
CONTACT_FROM_EMAIL_INSTITUTION=institution@lirie.ch
CONTACT_FROM_EMAIL_TRANSPORT=entreprise@lirie.ch
CONTACT_FROM_EMAIL_DEMO=demo@lirie.ch
CONTACT_FROM_EMAIL_BILLING=facturation@lirie.ch
CONTACT_FROM_EMAIL_FAMILY=famille@lirie.ch

CONTACT_AUTOREPLY_ENABLED=true
CONTACT_AUTOREPLY_FROM_EMAIL=noreply@lirie.ch
CONTACT_AUTOREPLY_FROM_NAME=LIRIE
CONTACT_AUTOREPLY_LOGO_URL=https://www.lirie.ch/logo-lirie.png

# --- Cookies & session (HTTPS ; aligné docker-compose.production.yml) ---
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
COOKIE_HTTP_ONLY=true
COOKIE_PATH=/
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
REMEMBER_COOKIE_SECURE=true
REMEMBER_COOKIE_SAMESITE=Lax

# --- JWT durées (secondes) — complète JWT_MOBILE_* / JWT_DECODE_LEEWAY du bloc CI ---
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRES_SECONDS=7776000

# --- SQLAlchemy / perf requêtes ---
SQLALCHEMY_QUERY_TIMEOUT=5.0
SQLALCHEMY_ECHO=false
SQLALCHEMY_RECORD_QUERIES=false

# --- Observabilité (charge prod : traces Sentry modérées) ---
LOG_LEVEL=INFO
SENTRY_TRACES_SAMPLE_RATE=0.1
WERKZEUG_LOG_LEVEL=ERROR

# --- Rate limiting (Redis) — aligné backend/config.py ProductionConfig ---
RATELIMIT_STRATEGY=moving-window
RATELIMIT_CONFIG_VERSION=v1
RATELIMIT_KEY_TTL=7200
RATELIMIT_DEFAULT_LIMITS="1000 per hour"
RATELIMIT_DISPATCH_RUN="30 per hour"
RATELIMIT_DISPATCH_TRIGGER="50 per hour"
RATELIMIT_COMPANY_DISPATCH_RUN="10 per minute"
RATELIMIT_COMPANY_DISPATCH_OPTIMIZER="10 per minute"

# --- Postgres / Redis (réseau Docker interne) ---
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Celery ---
CELERY_TIMEZONE=Europe/Zurich

# --- Admin Ops (GET /api/v1/platform/status) ---
PLATFORM_STATUS_TIMEOUT_SECONDS=2.5
ADMIN_IP_WHITELIST_REQUIRED=false

# --- API / sécurité (même logique que docker-compose.production.yml environment) ---
FLASK_APP=app.py
API_LEGACY_ENABLED=false
API_DOCS=off
SECURITY_2FA_ENABLED=false
IP_MASK_MODE=first_octet
AUDIT_LOG_RETENTION_DAYS=730

# --- Workers / RL (image prod standard sans stack RL lourde) ---
GUNICORN_WORKERS=6
RL_ENABLED=false
WITH_RL=false
RL_WORKER_URL=http://atmr-rl-worker:5000
ML_MODELS_PATH=/app/data/ml
RL_MODELS_PATH=/app/data/rl

# --- Firebase (chemin conteneur ; JSON monté sur l’hôte) ---
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# --- OPENWEATHER_API_KEY : secret → uniquement dans .env.production.local sur le serveur ---
