# =============================================================================
# Surcharges serveur — /srv/atmr/.env.production.local (NON versionné)
# =============================================================================
# Fusionné en DERNIER par deploy-production.sh après le bloc CI + fragment.
# Ne mettre ici QUE :
#   - secrets absents du dépôt / GitHub Actions
#   - surcharges opérationnelles propres au serveur (rate limit WS, Twilio, etc.)
#
# Ne PAS dupliquer scripts/env.production.defaults.fragment (contact, cookies,
# Kafka flags, topics .v2, GUNICORN_*, etc.) — déjà appendés à chaque deploy.
#
# Modèles complémentaires :
#   - scripts/env.production.local.kafka-v2.example  (obsolète si fragment à jour)
#   - scripts/env.production.local.twilio.example
# =============================================================================

# --- F-01 ingestion GPS interne → scripts/env.production.local.fragment.example ---

# --- OpenWeather (secret — console https://home.openweathermap.org/api_keys) ---
OPENWEATHER_API_KEY=

# TTL cache météo (optionnel ; défaut code 21600 s)
OPENWEATHER_CACHE_TTL=21600

# --- Brevo SMTP — uniquement si EMAIL_PROVIDER_MODE=brevo_smtp (sinon laisser vide) ---
BREVO_SMTP_PASSWORD=

# --- Alertes applicatives (webhook optionnel) ---
ALERTING_EMAIL_WEBHOOK_URL=

# --- Admin Ops — IPs/CIDR pour /api/v1/platform/status (vide = pas de filtre) ---
ADMIN_IP_WHITELIST=

# --- JWT / chiffrement legacy (laisser vide sauf migration) ---
JWT_LEGACY_SECRET_KEYS=
JWT_LEGACY_SECRET_KEY=
LEGACY_ENCRYPTION_KEYS=

# --- Surcharges opérationnelles (exemples — adapter au besoin) ---
# WS_DRIVER_LOCATION_BATCH_LIMIT=12
# WS_DRIVER_LOCATION_BATCH_WINDOW_SEC=5

# --- Twilio SMS activation (voir scripts/env.production.local.twilio.example) ---
# SMS_NOTIFICATIONS_ENABLED=true
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
