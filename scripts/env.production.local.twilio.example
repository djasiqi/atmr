# =============================================================================
# SMS d'activation compte (Twilio) — surcharge serveur production
#
# Ce fichier est un MODÈLE versionné. Ne pas y mettre de vrais secrets.
#
# Installation sur le serveur (/srv/atmr) :
#   1. ssh vers le serveur de production
#   2. cd /srv/atmr
#   3. Copier ce bloc dans .env.production.local (créer le fichier s'il n'existe pas)
#   4. Remplacer les valeurs AC… / token / numéro par celles de la console Twilio
#   5. Redémarrer le backend :
#        docker compose -f docker-compose.production.yml up -d backend
#   6. Vérifier :
#        docker compose -f docker-compose.production.yml exec backend env | grep -E 'SMS_|TWILIO_'
#
# .env.production.local est fusionné à la fin de .env.production à chaque
# deploy-production.sh (non écrasé par la CI).
#
# Alternative CI : secrets GitHub TWILIO_* + SMS_NOTIFICATIONS_ENABLED (voir deploy.yml).
# =============================================================================

SMS_NOTIFICATIONS_ENABLED=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+41791234567
