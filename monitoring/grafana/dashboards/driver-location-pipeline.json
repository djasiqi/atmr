{
  "id": null,
  "uid": "driver-location-pipeline-atmr",
  "title": "Driver Location Pipeline (PR1)",
  "description": "Métriques backend: driver_location_received_total, driver_location_processed_total, driver_location_fanout_events_total. Pas de label driver_id sur ces compteurs — diagnostic par chauffeur via logs LOCATION_CORRELATION_LOGS ou évolutions futures.\n\nLecture rapide: received > processed → rejet / arbitrage / erreur avant fin de traitement. processed > fanout → fanout partiel ou chemin sans emit (ex. rejected_invalid). Ratio canon bas → surtout accepted_observability_only. Le panel latence ne couvre que le segment socket single instrumenté (voir description du panel).",
  "tags": ["atmr", "driver-location", "prometheus", "pr1", "realtime"],
  "timezone": "browser",
  "refresh": "10s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Débit: received vs processed (global)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(driver_location_received_total[1m]))",
          "legendFormat": "received",
          "refId": "A"
        },
        {
          "expr": "sum(rate(driver_location_processed_total[1m]))",
          "legendFormat": "processed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 2,
      "title": "Received par transport",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (transport) (rate(driver_location_received_total[1m]))",
          "legendFormat": "{{transport}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 3,
      "title": "Processed par accept_status (canon / observabilité / rejet)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (accept_status) (rate(driver_location_processed_total[1m]))",
          "legendFormat": "{{accept_status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 4,
      "title": "Fanout par event Socket.IO",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (event) (rate(driver_location_fanout_events_total[1m]))",
          "legendFormat": "{{event}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 5,
      "title": "Fanout par accept_status",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (accept_status) (rate(driver_location_fanout_events_total[1m]))",
          "legendFormat": "{{accept_status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 6,
      "title": "Ratio processed canonical / total (5m)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(driver_location_processed_total{accept_status=\"accepted_canonical\"}[5m])) / sum(rate(driver_location_processed_total[5m]))",
          "legendFormat": "ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.3, "color": "yellow" },
              { "value": 0.6, "color": "green" }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 7,
      "title": "Latence socket driver_location → fanout (p95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(driver_location_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(driver_location_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "description": "DEPRECATED — chemin socket unitaire uniquement. Utiliser driver_location_batch_latency_seconds."
    },
    {
      "id": 9,
      "title": "Latence Kafka E2E raw→processed (p95) — KPI GPS",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 31, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tracking_kafka_e2e_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(tracking_kafka_e2e_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 2, "color": "red" }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "description": "STOP GATE optimisation Kafka : P95 < 2 s (ingest_consumer). Voir docs/ops/kafka-optimization-lirie.md"
    },
    {
      "id": 8,
      "title": "Batch latency p50/p95 (driver_location_batch)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(driver_location_batch_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(driver_location_batch_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 } }
    },
    {
      "id": 9,
      "title": "Rate limit batch (driver_location_batch)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(driver_location_batch_rate_limited_total[5m]))",
          "legendFormat": "rate_limited/s",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 4 } }
    },
    {
      "id": 10,
      "title": "Funnel batch points",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 39, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(driver_location_batch_points_received_total[5m]))",
          "legendFormat": "received",
          "refId": "A"
        },
        {
          "expr": "sum(rate(driver_location_batch_points_canonical_total[5m]))",
          "legendFormat": "canonical",
          "refId": "B"
        },
        {
          "expr": "sum(rate(driver_location_batch_points_observability_total[5m]))",
          "legendFormat": "observability",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 11,
      "title": "Tracking ID propagation (Stop Gate G2)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 39, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(driver_location_tracking_id_propagated_total[5m])) / clamp_min(sum(rate(driver_location_batch_points_received_total[5m])), 1e-9)",
          "legendFormat": "ratio propagated",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 12,
      "title": "GPS accuracy p95 by platform",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 47, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(driver_location_gps_accuracy_meters_bucket[5m])) by (le, platform))",
          "legendFormat": "{{platform}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "lengthm", "decimals": 1 } }
    },
    {
      "id": 13,
      "title": "Coût tracking (received / fanout / redis write)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 47, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(driver_location_received_total[5m]))",
          "legendFormat": "received",
          "refId": "A"
        },
        {
          "expr": "sum(rate(driver_location_fanout_events_total[5m]))",
          "legendFormat": "fanout",
          "refId": "B"
        },
        {
          "expr": "sum(rate(driver_location_canonical_redis_write_total[5m]))",
          "legendFormat": "redis canonical write",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    }
  ],
  "schemaVersion": 38,
  "version": 3
}
