      }
    },
    {
      "id": 9,
      "title": "Total Rate Limit Hits (5m)",
      "type": "stat",
      "gridPos": {"x": 6, "y": 20, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(increase(push_rate_limit_hits_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 5, "color": "red"}
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "orientation": "auto"
      }
    },
    {
      "id": 10,
      "title": "Retries par Type",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [
