{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(rate(driver_device_health_reports_total{battery_optimized=\"true\"}[5m])) / clamp_min(sum(rate(driver_device_health_reports_total[5m])), 0.001)",
          "legendFormat": "battery optimized"
        }
      ],
      "title": "% drivers battery optimized",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(driver_device_last_fix_age_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 fix age"
        }
      ],
      "title": "Fix age p95 (mobile heartbeat)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(silent_push_wake_total{result=\"acked\"}[5m])) / clamp_min(sum(rate(silent_push_wake_total{result=\"sent\"}[5m])), 0.001)",
          "legendFormat": "wake success"
        }
      ],
      "title": "Silent push wake success rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (manufacturer) (rate(driver_device_stale_fix_total[1h]))",
          "legendFormat": "{{manufacturer}}"
        }
      ],
      "title": "Stale fix rate by OEM",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (sync_type, status) (rate(silent_notifications_sent_total[5m]))",
          "legendFormat": "{{sync_type}} {{status}}"
        }
      ],
      "title": "Silent notifications sent",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 6,
      "targets": [
        {
          "expr": "sum(rate(driver_device_health_reports_total{tracking_active=\"true\"}[5m])) / clamp_min(sum(rate(driver_device_health_reports_total[5m])), 0.001)",
          "legendFormat": "tracking active"
        }
      ],
      "title": "% drivers tracking active in mission",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "cpm" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 7,
      "targets": [
        {
          "expr": "sum(rate(driver_device_health_reports_total[1m])) * 60",
          "legendFormat": "heartbeats/min"
        }
      ],
      "title": "Heartbeats received per minute",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 8,
      "targets": [
        {
          "expr": "sum(rate(push_fcm_background_handler_no_callback_total[5m]))",
          "legendFormat": "{{platform}}"
        }
      ],
      "title": "FCM background handler no callback",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 9,
      "targets": [
        {
          "expr": "sum by (key) (rate(device_health_redis_write_total[5m]))",
          "legendFormat": "{{key}}"
        },
        {
          "expr": "sum by (caller) (rate(device_health_legacy_read_total[5m]))",
          "legendFormat": "legacy read {{caller}}"
        }
      ],
      "title": "Redis device-health migration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 10,
      "targets": [
        {
          "expr": "sum by (field) (rate(device_health_dual_write_mismatch_total[5m]))",
          "legendFormat": "{{field}}"
        }
      ],
      "title": "Dual-write mismatches",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 11,
      "targets": [
        {
          "expr": "sum(rate(tracking_mission_live_missing_mission_id_total[5m]))",
          "legendFormat": "missing mission_id/s (post-déploiement)"
        }
      ],
      "title": "mission_live sans mission_id (doit être 0 post-P0-C)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 12,
      "targets": [
        {
          "expr": "sum(rate(driver_location_processed_total{accept_status=\"accepted_observability_only\"}[5m])) / clamp_min(sum(rate(driver_location_processed_total[5m])), 0.001)",
          "legendFormat": "observability only"
        }
      ],
      "title": "Ratio positions observability_only",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "id": 13,
      "targets": [
        {
          "expr": "sum(increase(tracking_delivery_result_total{mode=\"availability_presence\",transport=\"http\",result=\"success\"}[48h]))",
          "legendFormat": "presence http success (gate #2)"
        }
      ],
      "title": "STOP GATE — availability_presence HTTP success (48h)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "id": 14,
      "targets": [
        {
          "expr": "sum(increase(tracking_delivery_result_total{result=\"forbidden\"}[48h]))",
          "legendFormat": "forbidden (gate #5 alerte)"
        }
      ],
      "title": "STOP GATE — forbidden inattendu (48h, cible 0)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "id": 15,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(driver_tracking_position_freshness_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 freshness"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(driver_tracking_position_freshness_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 freshness"
        }
      ],
      "title": "GPS freshness p50/p99 (pipeline)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "id": 16,
      "targets": [
        {
          "expr": "sum(rate(driver_device_health_received_total{constraint_reason=\"fix_stale\"}[5m])) / clamp_min(sum(rate(driver_device_health_received_total[5m])), 0.001)",
          "legendFormat": "fix_stale rate"
        }
      ],
      "title": "Drivers fix_stale ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 56 },
      "id": 17,
      "targets": [
        {
          "expr": "sum(increase(driver_location_received_total[10m]))",
          "legendFormat": "locations received"
        }
      ],
      "title": "Ingest volume (10m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 56 },
      "id": 18,
      "targets": [
        {
          "expr": "sum(increase(tracking_invariant_violation_total[1h])) by (invariant_id)",
          "legendFormat": "{{invariant_id}}"
        }
      ],
      "title": "Invariant violations (1h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 56 },
      "id": 19,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tracking_pipeline_stage_latency_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "{{stage}} p95"
        }
      ],
      "title": "Pipeline stage latency p95",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["tracking", "device-health", "atmr"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(driver_device_health_reports_total, manufacturer)",
        "hide": 0,
        "includeAll": true,
        "label": "Manufacturer",
        "multi": true,
        "name": "manufacturer",
        "query": { "query": "label_values(driver_device_health_reports_total, manufacturer)", "refId": "A" },
        "refresh": 2,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(driver_device_health_reports_total, platform)",
        "hide": 0,
        "includeAll": true,
        "label": "Platform",
        "multi": true,
        "name": "platform",
        "query": { "query": "label_values(driver_device_health_reports_total, platform)", "refId": "A" },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Driver Tracking Health",
  "uid": "driver-tracking-health",
  "version": 1
}
