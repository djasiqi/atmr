# Configuration coverage.py — source de vérité unique (CI: --cov-config=backend/.coveragerc)
# Les omits ici définissent le PÉRIMÈTRE mesuré. check_coverage.py analyse le XML
# sans redéfinir ce périmètre.
#
# Catégories d'omit autorisées: legacy | training | demo | tooling
# Voir docs/backend/coverage-policy.md

[run]
# Le package mesuré est fourni par le CLI (--cov=backend depuis la racine monorepo,
# ou --cov=. depuis backend/). Ne pas figer source= ici pour éviter un dénominateur faux.
relative_files = True
omit =
    */tests/*
    */test_*
    */__pycache__/*
    */migrations/*
    */venv/*
    */env/*
    */node_modules/*
    */scripts/*
    */conftest.py
    */factories.py
    */.venv/*
    */htmlcov/*
    */instance/*
    */temp_*/*
    */docs/*
    # legacy — shim post-migration services.ml.rl (pas d'implémentation canonique)
    */services/rl/*
    # training / tooling ML — hors chemin requête API (runtime RL reste mesuré)
    */services/ml/rl/hyperparameter_tuner.py
    */services/ml/rl/optimal_hyperparameters.py
    # tooling — seed démo (hors requête HTTP courante ; access_service / scoring restent mesurés)
    */services/demo/seed_service.py
    */services/demo/seed_spec.py

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstract

# Seuils par module : scripts/check_coverage.py (CRITICAL_MODULES / THRESHOLDS)
# - unified_dispatch core/optimization/utils (engine, solver, heuristics, autonomous,
#   assignment_applier, settings, queue) ≥95% (+ shims apply/solver/settings/autonomous_manager)
# - routes/auth.py ≥95%
# - services/geolocation/osrm.py ≥90%
# - routes/dispatch/rl_helpers.py, services/ml/rl/suggestion_generator.py ≥80%
# - autres critiques ≥80%
#
# Vérification:
#   python scripts/check_coverage.py --coverage-xml coverage.xml --fail-under 70
#   python scripts/check_coverage.py --coverage-xml coverage.xml --require-critical

[html]
directory = htmlcov

[xml]
output = coverage.xml
