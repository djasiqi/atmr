".env" 
"venv/"

# Artefacts temporaires
*.csv
*.xlsx
!data/samples/*.xlsx

# Scripts de debug
test_delete.py
check_*.py
# Use case métier (nom check_* historique), pas un script jetable
!application/invoices/check_overdue_invoices.py
# Script CI couverture (référencé par .github/workflows/backend-tests.yml)
!scripts/check_coverage.py

# Celery Beat persistence
celerybeat-schedule*

# Coverage et tests
.pytest_cache/
.coverage
htmlcov/
*.pyc
__pycache__/