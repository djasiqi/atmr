# =============================================================================
# env.production.example - Template pour la production ATMR
# =============================================================================
# Ce fichier documente les variables utilisées en production.
# Le fichier .env.production réel est GÉNÉRÉ par scripts/deploy-production.sh
# à partir des GitHub Secrets. Les variables ci-dessous (section "Config par défaut")
# sont injectées automatiquement par le script — pas besoin de les mettre en secrets.
# =============================================================================

# --- Secrets (depuis GitHub Secrets, passés au script de déploiement) ---
# DATABASE_URL=
# SQLALCHEMY_DATABASE_URI=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_HOST=postgres
# REDIS_PASSWORD=
# REDIS_URL=
# SECRET_KEY=
# JWT_SECRET_KEY=
# APP_ENCRYPTION_KEY_B64=
# MASTER_ENCRYPTION_KEY=
# DOCKER_IMAGE=
# DOCKER_TAG=
# MAIL_PASSWORD=
# SENTRY_DSN=
# PDF_BASE_URL=
# GOOGLE_MAPS_API_KEY=
# GRAFANA_ADMIN_USER=
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_ROOT_URL=
# SLACK_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# ALERTMANAGER_FROM_EMAIL=
# ALERT_EMAIL_TO=
# SOCKETIO_CORS_ORIGINS=
# BREVO_API_KEY=
# FLASK_ENV=production
# FLASK_CONFIG=production
# ENVIRONMENT=production

# --- Config par défaut (injectée par deploy-production.sh, pas de secret) ---
EMAIL_PROVIDER_MODE=brevo_api
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_PROVIDER=brevo
SMTP_FROM_EMAIL=noreply@lirie.ch
SMTP_FROM_NAME=LIRIE

# Destinataires internes
CONTACT_EMAIL_SUPPORT=info@lirie.ch
CONTACT_EMAIL_INSTITUTION=info@lirie.ch
CONTACT_EMAIL_TRANSPORT=info@lirie.ch
CONTACT_EMAIL_DEMO=info@lirie.ch
CONTACT_EMAIL_BILLING=info@lirie.ch
CONTACT_EMAIL_FAMILY=info@lirie.ch

# Sender visible par catégorie (doivent être valides dans Brevo)
CONTACT_FROM_EMAIL_SUPPORT=support@lirie.ch
CONTACT_FROM_EMAIL_INSTITUTION=institution@lirie.ch
CONTACT_FROM_EMAIL_TRANSPORT=entreprise@lirie.ch
CONTACT_FROM_EMAIL_DEMO=demo@lirie.ch
CONTACT_FROM_EMAIL_BILLING=facturation@lirie.ch
CONTACT_FROM_EMAIL_FAMILY=famille@lirie.ch

# Auto-réponse client
CONTACT_AUTOREPLY_ENABLED=true
CONTACT_AUTOREPLY_FROM_EMAIL=noreply@lirie.ch
CONTACT_AUTOREPLY_FROM_NAME=LIRIE

# URLs frontend
FRONTEND_URL=https://www.lirie.ch/
DEMO_MAGIC_LINK_BASE_URL=https://www.lirie.ch/demo-access/consume
