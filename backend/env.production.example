# =============================================================================
# env.production.example — Modèle pour .env.production (serveur ou test local)
# =============================================================================
# Ne pas committer de vraies valeurs. Copier vers /srv/atmr/.env.production (ou
# backend/.env.production) et renseigner les secrets.
#
# Le déploiement GitHub (scripts/deploy-production.sh) RÉGÉNÈRE ce fichier à
# partir des secrets CI. Les variables « hors CI » (contact, JWT optionnel,
# météo, etc.) doivent être réinjectées après deploy OU fusionnées depuis un
# fichier séparé sur le serveur (voir backend/docs/PLATFORM_ENV.md).
#
# --- Workflow recommandé (essentiel sur Git + secrets locaux + prod après build) ---
# 1) Git : uniquement CE fichier (env.production.example) — aucun secret, placeholders OK.
# 2) Local : backend/.env.production — copie depuis le serveur (scp) ou fusion manuelle ;
#    reste ignoré par Git (.env.*). Sert de référence secrète pour toi / outils locaux.
# 3) Fin de build / deploy : deploy-production.sh RÉÉCRIT /srv/atmr/.env.production puis
#    concatène scripts/env.production.defaults.fragment (contact par catégorie, cookies,
#    URLs Lirie, JWT access/refresh, SQLAlchemy, Sentry traces, rate limits complets
#    alignés config.py, POSTGRES_SSLMODE=disable, Admin Ops, API_DOCS/legacy, audit,
#    Gunicorn/RL paths, etc.) + CELERY_BROKER_URL depuis REDIS_URL.
#    → Inutile de dupliquer ces clés en secrets GitHub si les défauts Lirie te conviennent.
# 4) Optionnel sur le serveur : /srv/atmr/.env.production.local (non Git) fusionné en fin
#    de fichier pour OPENWEATHER, ADMIN_IP_WHITELIST, surcharges d’emails, etc.
# 5) Après un deploy avec le script à jour : .env.production = secrets CI + fragment
#    (contact/cookies/perf) + .env.production.local ; plus complet que l’ancien « 56 clés ».
# =============================================================================

# -----------------------------------------------------------------------------
# 0. Vérification prod — /srv/atmr/.env.production (SSH deploy@138.201.155.201)
# -----------------------------------------------------------------------------
# Inventaire « secrets CI » historique ~56 noms ; avec env.production.defaults.fragment
# le fichier sur disque contient des dizaines de clés supplémentaires (contact, cookies…).
# Aucune valeur secrète ci-dessous — uniquement l’inventaire pour aligner ce modèle.
#
# Clés présentes sur le serveur au dernier contrôle :
#   ALERT_EMAIL_TO, ALERTMANAGER_FROM_EMAIL, ALLOW_NON_DEMO_SEED,
#   APP_ENCRYPTION_KEY_B64, BREVO_API_KEY, CONTACT_EMAIL_DEFAULT, CONTACT_EMAIL_DEMO,
#   DATABASE_URL, DEMO_DEFAULT_PASSWORD, DEMO_EMAIL_FROM, DEMO_EMAIL_SALES,
#   DOCKER_IMAGE, DOCKER_TAG, EMAIL_NOTIFICATIONS_ENABLED, EMAIL_PROVIDER,
#   ENVIRONMENT, FLASK_CONFIG, FLASK_ENV,
#   GATEWAY_APP_AUTH_URL, GATEWAY_APP_ME_URL, GATEWAY_DEMO_AUTH_URL, GATEWAY_DEMO_ME_URL,
#   GOOGLE_MAPS_API_KEY, GRAFANA_ADMIN_PASSWORD, GRAFANA_ADMIN_USER, GRAFANA_ROOT_URL,
#   JWT_DECODE_LEEWAY_SECONDS, JWT_MOBILE_ACCESS_TOKEN_EXPIRES_SECONDS, JWT_SECRET_KEY,
#   MAIL_PASSWORD, MASTER_ENCRYPTION_KEY, PDF_BASE_URL,
#   PLATFORM_API_URL_PROD, PLATFORM_LINK_ALERTMANAGER, PLATFORM_LINK_GRAFANA,
#   PLATFORM_LINK_PROMETHEUS, POSTGRES_DB, POSTGRES_HOST, POSTGRES_PASSWORD, POSTGRES_USER,
#   REDIS_PASSWORD, REDIS_URL, SECRET_KEY, SENTRY_DSN,
#   SMTP_FROM_EMAIL, SMTP_FROM_NAME, SMTP_HOST, SMTP_PASSWORD, SMTP_PORT, SMTP_USERNAME,
#   SOCKETIO_CORS_ORIGINS, SOCKETIO_PING_INTERVAL_SECONDS, SOCKETIO_PING_TIMEOUT_SECONDS,
#   SQLALCHEMY_DATABASE_URI, USE_GOOGLE_PLACES
#
# Absent du fichier généré sur cette prod (à fusionner depuis ce modèle si besoin) :
#   — Les autres CONTACT_* / CONTACT_FROM_* / CONTACT_AUTOREPLY_* (formulaire contact).
#   — COOKIE_*, SESSION_*, JWT legacy, OPENWEATHER, FRONTEND_URL, DEMO_MAGIC_LINK_BASE_URL,
#     CELERY_TIMEZONE, EMAIL_PROVIDER_MODE, §1b SQLAlchemy, etc.
#   — PLATFORM_API_URL_DEMO : non présent sur le serveur vérifié ; le script actuel
#     (deploy-production.sh) l’ajoute si défini côté CI (vars GitHub). Ajouter à la main
#     ou redéployer avec vars à jour.
# GRAFANA_ROOT_URL et PLATFORM_LINK_GRAFANA : même URL Grafana (confirmé en prod).

# -----------------------------------------------------------------------------
# 1. Injecté par deploy-production.sh / GitHub Actions (référence)
# -----------------------------------------------------------------------------
# DATABASE_URL=
# SQLALCHEMY_DATABASE_URI=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=
# REDIS_PASSWORD=
# REDIS_URL=
# SECRET_KEY=
# JWT_SECRET_KEY=
# APP_ENCRYPTION_KEY_B64=
# MASTER_ENCRYPTION_KEY=
# DOCKER_IMAGE=
# DOCKER_TAG=
# MAIL_PASSWORD=
# SENTRY_DSN=
# PDF_BASE_URL=
# GOOGLE_MAPS_API_KEY=
# USE_GOOGLE_PLACES=true
# GRAFANA_ADMIN_USER=
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_ROOT_URL=https://grafana.lirie.ch
# → Au deploy, le script écrit PLATFORM_LINK_GRAFANA=${GRAFANA_ROOT_URL} (une seule URL source).
# → Pas de 2ᵉ URL Grafana indépendante côté CI ; en manuel sur le serveur, garder les deux identiques.
# PLATFORM_LINK_GRAFANA=   # rempli automatiquement = GRAFANA_ROOT_URL ; lu par backend/config.py
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# ALERTMANAGER_FROM_EMAIL=
# ALERT_EMAIL_TO=
# SOCKETIO_CORS_ORIGINS=
# BREVO_API_KEY=
# FLASK_ENV=production
# FLASK_CONFIG=production
# ENVIRONMENT=production
# JWT_MOBILE_ACCESS_TOKEN_EXPIRES_SECONDS=259200
# JWT_DECODE_LEEWAY_SECONDS=300
# SOCKETIO_PING_TIMEOUT_SECONDS=180
# SOCKETIO_PING_INTERVAL_SECONDS=25
# EMAIL_NOTIFICATIONS_ENABLED=true
# EMAIL_PROVIDER=brevo

# -----------------------------------------------------------------------------
# 1b. Base de données & SQLAlchemy (backend/config.py)
# -----------------------------------------------------------------------------
# Timeout des requêtes SQL (secondes). Défaut dans le code : 5.0 si absent.
# SQLALCHEMY_QUERY_TIMEOUT=5.0
# Logs SQL verbeux — désactivé en prod sauf diagnostic court.
# SQLALCHEMY_ECHO=false
# Flask-SQLAlchemy query tracking (profilage requêtes).
# SQLALCHEMY_RECORD_QUERIES=false

# -----------------------------------------------------------------------------
# 2. Emails — page contact & notifications (souvent maintenu sur le serveur)
# -----------------------------------------------------------------------------
# Mode Brevo: brevo_api (défaut) | brevo_smtp (factures avec CID, etc.)
EMAIL_PROVIDER_MODE=brevo_api

SMTP_FROM_EMAIL=noreply@lirie.ch
SMTP_FROM_NAME=LIRIE

# Destinataires internes par catégorie (formulaire contact)
CONTACT_EMAIL_SUPPORT=info@lirie.ch
CONTACT_EMAIL_INSTITUTION=info@lirie.ch
CONTACT_EMAIL_TRANSPORT=info@lirie.ch
CONTACT_EMAIL_DEMO=info@lirie.ch
CONTACT_EMAIL_BILLING=info@lirie.ch
CONTACT_EMAIL_FAMILY=info@lirie.ch

# Expéditeurs visibles (doivent être autorisés dans Brevo)
CONTACT_FROM_EMAIL_SUPPORT=support@lirie.ch
CONTACT_FROM_EMAIL_INSTITUTION=institution@lirie.ch
CONTACT_FROM_EMAIL_TRANSPORT=entreprise@lirie.ch
CONTACT_FROM_EMAIL_DEMO=demo@lirie.ch
CONTACT_FROM_EMAIL_BILLING=facturation@lirie.ch
CONTACT_FROM_EMAIL_FAMILY=famille@lirie.ch

CONTACT_EMAIL_DEFAULT=info@lirie.ch
CONTACT_AUTOREPLY_ENABLED=true
CONTACT_AUTOREPLY_FROM_EMAIL=noreply@lirie.ch
CONTACT_AUTOREPLY_FROM_NAME=LIRIE
# CONTACT_AUTOREPLY_LOGO_URL=https://www.lirie.ch/logo-lirie.png

# -----------------------------------------------------------------------------
# 3. JWT — durées & rotation (optionnel ; défauts dans config.py)
# -----------------------------------------------------------------------------
# JWT_ACCESS_TOKEN_EXPIRES_SECONDS=3600
# JWT_REFRESH_TOKEN_EXPIRES_SECONDS=7776000
# JWT_LEGACY_SECRET_KEYS=
# LEGACY_ENCRYPTION_KEYS=

# -----------------------------------------------------------------------------
# 4. Cookies & session (production)
# -----------------------------------------------------------------------------
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
# REMEMBER_COOKIE_SECURE=true
# REMEMBER_COOKIE_SAMESITE=Lax

# -----------------------------------------------------------------------------
# 5. Rate limiting (Redis)
# -----------------------------------------------------------------------------
# RATELIMIT_STRATEGY=moving-window
# RATELIMIT_CONFIG_VERSION=v1
# RATELIMIT_KEY_TTL=7200

# -----------------------------------------------------------------------------
# 6. Observabilité
# -----------------------------------------------------------------------------
# SENTRY_TRACES_SAMPLE_RATE=0.1
# WERKZEUG_LOG_LEVEL=ERROR
# LOG_LEVEL=INFO
# (SQLAlchemy echo / record_queries / query timeout → §1b)

# -----------------------------------------------------------------------------
# 7. Services externes
# -----------------------------------------------------------------------------
# OPENWEATHER_API_KEY=

# -----------------------------------------------------------------------------
# 8. Démo & magic link
# -----------------------------------------------------------------------------
DEMO_EMAIL_FROM=noreply@lirie.ch
DEMO_EMAIL_SALES=info@lirie.ch
DEMO_MAGIC_LINK_BASE_URL=https://www.lirie.ch/demo-access/consume
# DEMO_DEFAULT_PASSWORD=
ALLOW_NON_DEMO_SEED=true

# -----------------------------------------------------------------------------
# 9. URLs front & gateway (Docker interne)
# -----------------------------------------------------------------------------
FRONTEND_URL=https://www.lirie.ch/
GATEWAY_APP_AUTH_URL=http://backend:5000/api/v1/auth/login
GATEWAY_APP_ME_URL=http://backend:5000/api/v1/auth/me
GATEWAY_DEMO_AUTH_URL=http://backend:5000/api/v1/auth/login
GATEWAY_DEMO_ME_URL=http://backend:5000/api/v1/auth/me

# -----------------------------------------------------------------------------
# 10. Admin Ops / platform status (voir backend/docs/PLATFORM_ENV.md)
# -----------------------------------------------------------------------------
# GRAFANA_ROOT_URL (secret CI) alimente PLATFORM_LINK_GRAFANA dans .env généré
# (scripts/deploy-production.sh). En prod Lirie les deux valent typiquement la même URL.
# GRAFANA_ROOT_URL=https://grafana.lirie.ch
PLATFORM_API_URL_PROD=https://api.lirie.ch
# PLATFORM_API_URL_DEMO=
PLATFORM_LINK_GRAFANA=https://grafana.lirie.ch
PLATFORM_LINK_PROMETHEUS=https://prometheus.lirie.ch
PLATFORM_LINK_ALERTMANAGER=https://alertmanager.lirie.ch
# PLATFORM_STATUS_TIMEOUT_SECONDS=2.5

# Whitelist IP pour GET /api/v1/platform/status (CIDR séparés par virgules)
# ADMIN_IP_WHITELIST=
# En prod, exiger une whitelist renseignée :
# ADMIN_IP_WHITELIST_REQUIRED=false

# -----------------------------------------------------------------------------
# 11. Firebase — chemin dans le conteneur (fichier monté sur l’hôte)
# -----------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
# Mise à jour lifecycle DeviceToken après envoi FCM (désactivation seulement si token_invalid)
PUSH_DEVICE_TOKEN_LIFECYCLE_ENABLED=1

# -----------------------------------------------------------------------------
# 12. Worker RL (docker-compose.production.yml)
# -----------------------------------------------------------------------------
# RL_WORKER_URL=http://atmr-rl-worker:5000
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
CELERY_TIMEZONE=Europe/Zurich

# -----------------------------------------------------------------------------
# 13. Optionnel — factures / rappels en brevo_smtp (EMAIL_PROVIDER_MODE)
# -----------------------------------------------------------------------------
# Si EMAIL_PROVIDER_MODE=brevo_smtp (logo CID, etc.), renseigner le mot de passe
# SMTP Brevo dédié (voir backend/config.py — pas le même flux que BREVO_API_KEY).
# BREVO_SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# 14. Optionnel — surcharge par rapport à docker-compose.production.yml
# -----------------------------------------------------------------------------
# Déjà fixés dans compose si absent du .env :
# GUNICORN_WORKERS=6
# REDIS_HOST=redis
# POSTGRES_HOST=postgres
# API_DOCS=off
# API_LEGACY_ENABLED=false

# -----------------------------------------------------------------------------
# 15. Optionnel — surcharge avancée (souvent défini dans docker-compose ou défauts config.py)
# -----------------------------------------------------------------------------
# FLASK_APP=app.py
# COOKIE_HTTP_ONLY=true
# COOKIE_DOMAIN=
# COOKIE_PATH=/
# (SQLALCHEMY_* → §1b)
# PDF_PUBLIC_BASE_URL=
# PUBLIC_BASE_URL=
# UPLOADS_PUBLIC_BASE=/uploads
# SMTP_USER=   # alias de SMTP_USERNAME (services/notifications/email.py)
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# RATELIMIT_DEFAULT_LIMITS=
# RATELIMIT_DISPATCH_RUN=
# RATELIMIT_DISPATCH_TRIGGER=
# RATELIMIT_COMPANY_DISPATCH_RUN=
# RATELIMIT_COMPANY_DISPATCH_OPTIMIZER=
# ADMIN_IP_WHITELIST=   # CIDR séparés par virgules (voir aussi §10)
# RL_ENABLED=false
# WITH_RL=false
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0
# SECURITY_2FA_ENABLED=false
# IP_MASK_MODE=first_octet
# AUDIT_LOG_RETENTION_DAYS=730
# ML_MODELS_PATH=/app/data/ml
# RL_MODELS_PATH=/app/data/rl
