# Exemple — à fusionner dans .env sur le serveur lorsque Kafka embarqué (Compose) est déployé.
# Runbook complet : docs/ops/kafka-optimization-lirie.md

# -----------------------------------------------------------------------------
# RÈGLE D'OR — sécurité production
# -----------------------------------------------------------------------------
# - Les 4 flags ci-dessous doivent être cohérents (tous ON ou tous OFF).
# - Retry bootstrap : KAFKA_BOOTSTRAP_MAX_ATTEMPTS=5, KAFKA_BOOTSTRAP_MAX_BACKOFF_SEC=10
# -----------------------------------------------------------------------------

# --- Activer les clients Kafka (4 flags ensemble) ---
KAFKA_ENABLED=true
TRACKING_INGEST_ASYNC_ENABLED=true
TRACKING_PROCESSED_FANOUT_ENABLED=true
WS_KAFKA_CONSUMER_ENABLED=true

# --- Option A : miroir socket → Kafka (driver.location.raw), fire-and-forget ---
# Voie durable secondaire pour les positions reçues via le socket `driver_location_batch`.
# Non bloquant (n'attend pas l'ACK Kafka) : la voie live (canonical + fanout) reste la
# source du marqueur temps réel. Activer avec les flags ci-dessus si on veut la durabilité
# du chemin socket ; laisser à false pour ne persister que la voie HTTP/ingest.
TRACKING_SOCKET_KAFKA_MIRROR_ENABLED=false

# --- Persistance GPS dans ingest_consumer (5e flag — activer avec ASYNC=true) ---
# ⚠️ STOP GATE : n'activer qu'après P0-1 (filtrage bruit), P0-3 (OSRM timeout) et
# P1-1a (métrique + alerte lag) en place. Voir docs/ops/gps-tracking-pipeline.md.
TRACKING_INGEST_PERSIST_ENABLED=true
# Rollback republish-only (sans persistance DB) — exiger les deux lignes ensemble :
# TRACKING_INGEST_PERSIST_ENABLED=false
# TRACKING_INGEST_ALLOW_REPUBLISH_ONLY=true
# Premier deploy prod avec backlog raw : ignorer l'historique Kafka (option R7)
# TRACKING_INGEST_SEEK_TO_END_ON_START=true
KAFKA_PUBLISH_ACK_TIMEOUT_S=2

# --- OSRM snap timeout (P0-3 — verrouillé explicitement en prod) ---
# Borne la durée d'un snap OSRM par record ingéré ; doit rester < KAFKA_PUBLISH_ACK_TIMEOUT_S.
OSRM_SNAP_TIMEOUT_S=1.5
# Kill-switch granulaire de rollback : OSRM_SNAP_TIMEOUT_ENABLED=false neutralise le timeout
# sans désactiver la persistance (distinct de TRACKING_INGEST_PERSIST_ENABLED=false).
OSRM_SNAP_TIMEOUT_ENABLED=true

# --- Métriques Prometheus consumers Kafka ---
TRACKING_CONSUMER_METRICS_PORT=9115
TRACKING_FANOUT_METRICS_PORT=9116
TRACKING_KAFKA_LAG_METRIC_ENABLED=true

# --- Fichier Compose Kafka ---
# Phase 1 (défaut) : docker-compose.kafka.yml
# Phase 2 mono-broker : docker-compose.kafka.single.yml
KAFKA_COMPOSE_FILE=docker-compose.kafka.yml

# Bootstrap — Phase 1 (3 brokers)
KAFKA_BOOTSTRAP_SERVERS=kafka-broker-1:29092,kafka-broker-2:29092,kafka-broker-3:29092
# Phase 2 : KAFKA_BOOTSTRAP_SERVERS=kafka-broker-1:29092

# Réplication — Phase 1
KAFKA_BROKER_REPLICATION_FACTOR=2
KAFKA_TOPIC_REPLICATION_FACTOR=2
KAFKA_BROKER_MIN_INSYNC_REPLICAS=1
KAFKA_BROKER_TXN_MIN_ISR=1
# Phase 2 : RF=1 sur les deux KAFKA_*_REPLICATION_FACTOR

# Partitions & topics (Phase 1 optimisée LIRIE)
KAFKA_DEFAULT_PARTITIONS=6
KAFKA_DLQ_PARTITIONS=3
KAFKA_SMOKE_PARTITIONS=1
KAFKA_CREATE_INACTIVE_TOPICS=false

# Topics v2 — Phase 1 (défaut fragment ; surcharge possible via .env.production.local)
KAFKA_TOPIC_DRIVER_LOCATION_RAW=driver.location.raw.v2
KAFKA_TOPIC_DRIVER_LOCATION_PROCESSED=driver.location.processed.v2
KAFKA_TOPIC_DRIVER_LOCATION_DLQ=driver.location.dlq.v2
# KAFKA_TOPIC_NOTIFICATIONS_DLQ=notifications.dlq.v2

# UI Kafka optionnelle au deploy (sinon profile kafka-ui non démarré)
# KAFKA_UI_ENABLED=1

# Consumer groups
KAFKA_TRACKING_CONSUMER_GROUP=tracking-ingest-consumer-group
KAFKA_PROCESSED_FANOUT_GROUP=tracking-processed-fanout-group
KAFKA_DLQ_CONSUMER_GROUP=kafka-dlq-consumer-group
WS_KAFKA_GROUP_ID=ws-service-shared
WS_KAFKA_ENABLE_MISSION_EVENTS=false
WS_KAFKA_SEEK_TO_END_ON_START=true

# Notifications Kafka (hors pipeline tracking prod)
NOTIFICATIONS_KAFKA_PUBLISH_ENABLED=false
PUSH_KAFKA_FIRST_ENABLED=false
