# Exemple — à fusionner dans .env sur le serveur lorsque Kafka embarqué (Compose) est déployé.
# Les brokers doivent être joignables sous les noms kafka-broker-1…3 sur atmr-network (voir
# scripts/deploy-kafka-production.sh).

# -----------------------------------------------------------------------------
# RÈGLE D'OR — sécurité production
# -----------------------------------------------------------------------------
# - Si KAFKA_ENABLED=false : ne JAMAIS lancer le profile Compose kafka
#   (pas de `docker compose … --profile kafka`).
# - Avant de passer les flags à true : valider que les brokers répondent, ex. depuis un
#   conteneur sur atmr-network :
#     kafka-broker-api-versions --bootstrap-server kafka-broker-1:29092
# - Les 4 flags ci-dessous doivent être cohérents (tous ON ou tous OFF) avant
#   `scripts/deploy-kafka-production.sh` (garde-fou intégré ; override FORCE=1 si bootstrap initial).
# - Retry bootstrap Kafka (defaults code) : 5 tentatives, backoff plafonné à 10 s.
#   Surcharge explicite si besoin d’un cluster lent au démarrage :
#     KAFKA_BOOTSTRAP_MAX_ATTEMPTS=5
#     KAFKA_BOOTSTRAP_MAX_BACKOFF_SEC=10
# -----------------------------------------------------------------------------

# --- Activer les clients Kafka dans les services ATMR (les 4 à true ensemble en prod Kafka) ---
KAFKA_ENABLED=true
TRACKING_INGEST_ASYNC_ENABLED=true
TRACKING_PROCESSED_FANOUT_ENABLED=true
WS_KAFKA_CONSUMER_ENABLED=true

# Bootstrap interne Docker (identique aux valeurs par défaut du compose si non surchargé)
KAFKA_BOOTSTRAP_SERVERS=kafka-broker-1:29092,kafka-broker-2:29092,kafka-broker-3:29092

# Optionnel : cluster Confluent Cloud / autre hôte (remplace la ligne précédente)
# KAFKA_BOOTSTRAP_SERVERS=pkc-xxxx.region.provider.cloud:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Réplication topics — à aligner sur le nombre de brokers joignables (éviter RF=3 si un seul broker up)
# KAFKA_TOPIC_REPLICATION_FACTOR=3
# KAFKA_BROKER_REPLICATION_FACTOR=3
